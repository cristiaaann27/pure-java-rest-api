<?xml version="1.0" encoding="UTF-8"?>
<!--
  The IDE's view of the project, kept deliberately identical to what ./api does:
  two source folders, a Java 25 JRE on the module path, and no libraries at all.
  The empty library list is the point; there is nothing to resolve beyond the JDK.
-->
<classpath>
	<classpathentry kind="src" path="src/main/java"/>
	<classpathentry kind="src" path="src/test/java">
		<attributes>
			<attribute name="test" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-25">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="output" path="out/ide-classes"/>
</classpath>
