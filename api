#!/usr/bin/env bash
#
# Build tool for pure-java-rest-api.
#
# There is no Maven and no Gradle here: everything is done with javac, jar and
# java, which already ship with the JDK. Run "./api help" for the command list.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

readonly MAIN_SRC="src/main/java"
readonly TEST_SRC="src/test/java"
readonly OUT="out"
readonly CLASSES="$OUT/classes"
readonly TEST_CLASSES="$OUT/test-classes"
readonly JAR="$OUT/api.jar"
readonly MODULE="com.cristiannustes.api"
readonly MAIN_CLASS="com.cristiannustes.app.Application"
readonly TEST_RUNNER="com.cristiannustes.testing.TestRunner"
readonly MIN_JDK=25

JAVAC_FLAGS=(-encoding UTF-8 -g -Xlint:all -Werror)

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mError:\033[0m %s\n' "$*" >&2; exit 1; }

require_jdk() {
  command -v javac >/dev/null 2>&1 || die "javac is not on the PATH"
  local version
  version="$(javac -version 2>&1 | awk '{print $2}' | cut -d. -f1)"
  [ "$version" -ge "$MIN_JDK" ] || die "JDK $MIN_JDK or newer is required (found $version)"
}

# Prints the source files of a directory into a javac argument file.
collect_sources() {
  local src_dir="$1" list="$2"
  mkdir -p "$(dirname "$list")"
  find "$src_dir" -name '*.java' -type f | sort > "$list"
  [ -s "$list" ] || die "no sources found under $src_dir"
}

# True when a rebuild is needed: no previous build, a source edited since then,
# or the set of source files itself changed. That last check matters because a
# deleted or renamed file leaves a stale .class behind that would still run.
needs_rebuild() {
  local stamp="$1" previous="$2" current="$3" src_dir="$4"
  [ -f "$stamp" ] || return 0
  cmp -s "$current" "$previous" || return 0
  [ -n "$(find "$src_dir" -name '*.java' -type f -newer "$stamp" -print -quit)" ]
}

cmd_clean() {
  log "Removing $OUT"
  rm -rf "$OUT"
}

cmd_build() {
  require_jdk
  collect_sources "$MAIN_SRC" "$OUT/main-sources.next"
  if ! needs_rebuild "$OUT/.build-stamp" "$OUT/main-sources.txt" "$OUT/main-sources.next" "$MAIN_SRC"; then
    rm -f "$OUT/main-sources.next"
    log "Main sources are up to date"
    return
  fi
  log "Compiling main sources"
  rm -rf "$CLASSES"
  mkdir -p "$CLASSES"
  mv "$OUT/main-sources.next" "$OUT/main-sources.txt"
  javac "${JAVAC_FLAGS[@]}" -d "$CLASSES" "@$OUT/main-sources.txt"
  touch "$OUT/.build-stamp"
  log "Classes written to $CLASSES"
}

cmd_test() {
  cmd_build
  collect_sources "$TEST_SRC" "$OUT/test-sources.next"
  if needs_rebuild "$OUT/.test-stamp" "$OUT/test-sources.txt" "$OUT/test-sources.next" "$TEST_SRC" \
     || [ "$OUT/.build-stamp" -nt "$OUT/.test-stamp" ]; then
    log "Compiling test sources"
    rm -rf "$TEST_CLASSES"
    mkdir -p "$TEST_CLASSES"
    mv "$OUT/test-sources.next" "$OUT/test-sources.txt"
    # Tests run on the classpath, so module-info.class in $CLASSES is ignored.
    javac "${JAVAC_FLAGS[@]}" -cp "$CLASSES" -d "$TEST_CLASSES" "@$OUT/test-sources.txt"
    touch "$OUT/.test-stamp"
  else
    rm -f "$OUT/test-sources.next"
  fi
  log "Running tests"
  java -cp "$CLASSES:$TEST_CLASSES" "$TEST_RUNNER" "$TEST_CLASSES" "$@"
}

cmd_run() {
  cmd_build
  log "Starting $MODULE/$MAIN_CLASS"
  exec java -p "$CLASSES" -m "$MODULE/$MAIN_CLASS" "$@"
}

cmd_jar() {
  cmd_build
  log "Packaging $JAR"
  jar --create --file "$JAR" --main-class "$MAIN_CLASS" --module-version 2.0.0 -C "$CLASSES" .
  jar --describe-module --file "$JAR"
  log "Run it with: java -p $JAR -m $MODULE"
}

cmd_hash() {
  cmd_build
  java -cp "$CLASSES" com.cristiannustes.security.PasswordHashTool "$@"
}

cmd_help() {
  cat <<'USAGE'
Usage: ./api <command> [args]

  build          Compile src/main/java into out/classes
  test           Compile and run the test suite with the home made runner
  run            Start the HTTP server
  jar            Package a modular, executable jar
  hash <pwd>     Print a PBKDF2 hash usable as API_ADMIN_PASSWORD_HASH
  clean          Delete the out directory
  help           Show this message

No build tool, no dependencies: only javac, jar and java from the JDK.
USAGE
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
    build) cmd_build "$@" ;;
    test)  cmd_test  "$@" ;;
    run)   cmd_run   "$@" ;;
    jar)   cmd_jar   "$@" ;;
    hash)  cmd_hash  "$@" ;;
    clean) cmd_clean "$@" ;;
    help|-h|--help) cmd_help ;;
    *) die "unknown command '$command' (try ./api help)" ;;
  esac
}

main "$@"
